# ==============================================================================
# 1. Aplikasi & Keamanan Origin
# ==============================================================================
# Origin tunggal Web resmi untuk verifikasi CSRF & 4-Layer Web-Only Guard
APP_WEB_ORIGIN=https://ksatriagraphx.vercel.app

# Daftar Origin CORS yang diizinkan (Web + Capacitor Android Native) — Pisahkan dengan koma
# Catatan: Wildcard (*) DITOLAK KERAS demi keamanan.
ALLOWED_ORIGINS=https://ksatriagraphx.vercel.app,https://localhost,capacitor://localhost

# URL publik aplikasi Web
NEXT_PUBLIC_APP_URL=https://ksatriagraphx.vercel.app

# Base URL API backend yang dihubungi oleh client Web & Android APK
NEXT_PUBLIC_API_BASE_URL=https://ksatriagraphx.vercel.app

# ==============================================================================
# 2. Database — Neon PostgreSQL (Wajib Mengandung sslmode=require)
# ==============================================================================
# Koneksi runtime aplikasi (Pooled via PgBouncer untuk Serverless/Vercel)
DATABASE_URL=postgresql://neondb_owner:sample_password_placeholder@ep-sample-123456-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Koneksi langsung DDL/Migrasi ORM (Direct connection tanpa PgBouncer)
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:sample_password_placeholder@ep-sample-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ==============================================================================
# 3. Autentikasi & Keamanan Sesi (Minimal 32 Karakter Acak & Wajib Berbeda)
# ==============================================================================
# Kunci enkripsi/signing JWT Access Token (Generate 64-char hex unik)
JWT_ACCESS_SECRET=your-random-64-character-hex-access-secret-placeholder-min-32-chars

# Kunci signing/HMAC Refresh Token (Wajib berbeda dari JWT_ACCESS_SECRET)
JWT_REFRESH_SECRET=your-random-64-character-hex-refresh-secret-placeholder-min-32-chars

# Kredensial akun pemilik usaha (Owner) untuk inisialisasi / seed awal database
DEFAULT_OWNER_NAME=Owner Ksatria Graphx
DEFAULT_OWNER_USERNAME=owner
DEFAULT_OWNER_EMAIL=owner@ksatriagraphx.com
DEFAULT_OWNER_PASSWORD=sample_placeholder_owner_password_min_8_chars

# ==============================================================================
# 4. Media Storage — Vercel Blob (@vercel/blob)
# ==============================================================================
# Token akses baca-tulis store Vercel Blob untuk upload foto produk percetakan
BLOB_READ_WRITE_TOKEN=sample_vercel_blob_token_placeholder_min_chars
