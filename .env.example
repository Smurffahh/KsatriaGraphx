# ==============================================================================
# 1. Aplikasi & Keamanan Origin
# ==============================================================================
APP_WEB_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,https://localhost,capacitor://localhost
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# ==============================================================================
# 2. Database — Neon PostgreSQL (Wajib Mengandung sslmode=require)
# ==============================================================================
# Koneksi runtime aplikasi (Pooled via PgBouncer untuk lingkungan Serverless/Vercel)
DATABASE_URL=postgresql://neondb_owner:password@ep-sample-123456-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Koneksi langsung DDL/Migrasi ORM (Direct connection tanpa PgBouncer)
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:password@ep-sample-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ==============================================================================
# 3. Autentikasi & Keamanan Sesi (Minimal 32 Karakter Acak)
# ==============================================================================
JWT_ACCESS_SECRET=your-super-secret-jwt-access-token-min-32-chars-long
JWT_REFRESH_SECRET=your-super-secret-jwt-refresh-token-min-32-chars-long

# Kredensial Akun Pemilik Usaha (Owner) untuk Seed Awal Database
DEFAULT_OWNER_NAME=Owner Ksatria Graphx
DEFAULT_OWNER_USERNAME=owner
DEFAULT_OWNER_EMAIL=owner@ksatriagraphx.com
DEFAULT_OWNER_PASSWORD=owner123456

# ==============================================================================
# 4. Media Storage — Vercel Blob (@vercel/blob)
# ==============================================================================
# Token akses baca-tulis store Vercel Blob untuk upload foto produk percetakan
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_sample_token_min_chars
