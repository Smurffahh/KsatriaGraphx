# ==============================================================================
# Bagian 1: Auto-injected oleh Integrasi Neon & Vercel Blob di Vercel
# (Jangan diisi di .env.vercel agar bebas konflik saat Vercel Auto-Connect aktif)
# ==============================================================================
# Database — Neon PostgreSQL (Wajib menyertakan parameter sslmode=require)
DATABASE_URL=postgresql://neondb_owner:placeholder_password@ep-placeholder-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:placeholder_password@ep-placeholder.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Media Storage — Vercel Blob Storage
BLOB_READ_WRITE_TOKEN=sample_vercel_blob_token_placeholder_min_chars

# ==============================================================================
# Bagian 2: Variabel Aplikasi — Upload via .env.vercel
# ==============================================================================
# Kunci Autentikasi JWT (Minimal 32 karakter acak, wajib berbeda satu sama lain)
JWT_ACCESS_SECRET=your-random-64-character-hex-access-secret-placeholder
JWT_REFRESH_SECRET=your-random-64-character-hex-refresh-secret-placeholder

# Kredensial Default Pemilik Usaha (Owner)
DEFAULT_OWNER_NAME=Owner Ksatria Graphx
DEFAULT_OWNER_USERNAME=owner
DEFAULT_OWNER_EMAIL=owner@ksatriagraphx.my.id
DEFAULT_OWNER_PASSWORD=sample_password_placeholder

# Origin Web Resmi & Validasi CSRF
APP_WEB_ORIGIN=https://ksatriagraphx.vercel.app

# Allowlist Origin CORS (Web + Mobile Capacitor Android) — Dilarang wildcard (*)
ALLOWED_ORIGINS=https://ksatriagraphx.vercel.app,https://localhost,capacitor://localhost

# URL Publik Aplikasi Web & Base URL API Backend
NEXT_PUBLIC_APP_URL=https://ksatriagraphx.vercel.app
NEXT_PUBLIC_API_BASE_URL=https://ksatriagraphx.vercel.app

# ==============================================================================
# Bagian 3: Variabel Pengujian Lokal & E2E (Opsional)
# ==============================================================================
# Kredensial Uji E2E Playwright (Opsional jika DEFAULT_OWNER_* sudah terdefinisi)
E2E_OWNER_USERNAME=owner
E2E_OWNER_PASSWORD=sample_password_placeholder

