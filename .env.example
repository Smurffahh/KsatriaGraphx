# Database (Neon PostgreSQL with SSL)
DATABASE_URL=postgresql://neondb_owner:password@ep-sample-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Authentication Secrets (Separate Access & Refresh Secrets)
JWT_ACCESS_SECRET=your-super-secret-jwt-access-token-min-32-chars-long
JWT_REFRESH_SECRET=your-super-secret-jwt-refresh-token-min-32-chars-long

# Web Domain & CORS Allowlist
APP_WEB_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,https://localhost,capacitor://localhost

# Initial Seed Credentials (Owner)
DEFAULT_OWNER_NAME=Owner Ksatria Graphx
DEFAULT_OWNER_USERNAME=owner
DEFAULT_OWNER_EMAIL=owner@ksatriagraphx.com
DEFAULT_OWNER_PASSWORD=owner123456

# Object Storage (Cloudflare R2 / S3-compatible for Product Images)
R2_ACCOUNT_ID=sample_cloudflare_account_id
R2_ACCESS_KEY_ID=sample_r2_access_key_id
R2_SECRET_ACCESS_KEY=sample_r2_secret_access_key
R2_BUCKET_NAME=ksatria-graphx-media
R2_PUBLIC_URL=https://media.ksatriagraphx.com

# Client Public URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
